{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icv.commercial-service-catalog.schema.v2",
  "title": "Infrastructure Continuity Ventures Commercial Service Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "organization",
    "catalog_authority",
    "canonical_task_binding",
    "cosv_task_vector",
    "classification_vocabulary",
    "offerings"
  ],
  "properties": {
    "schema_version": {
      "const": "icv.commercial-service-catalog.v2"
    },
    "organization": {
      "const": "Infrastructure-Continuity-Ventures"
    },
    "catalog_authority": {
      "const": "COMMERCIAL_DESCRIPTION_ONLY"
    },
    "canonical_task_binding": {
      "type": [
        "string",
        "null"
      ]
    },
    "cosv_task_vector": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification_vocabulary": {
      "type": "array",
      "const": [
        "RELEASED_PRODUCT",
        "REVENUE_READY_SERVICE",
        "MANAGED_PILOT",
        "ASSESSMENT_ONLY",
        "DEVELOPMENT_PREVIEW",
        "INTERNAL_SUBSTRATE"
      ]
    },
    "offerings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offering_id",
          "name",
          "category",
          "classification",
          "customer_facing",
          "source_repository",
          "source_product",
          "version",
          "evidence_refs",
          "delivery_modes",
          "customer_outcome",
          "authority_boundary"
        ],
        "properties": {
          "offering_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "RELEASED_PRODUCT",
              "REVENUE_READY_SERVICE",
              "MANAGED_PILOT",
              "ASSESSMENT_ONLY",
              "DEVELOPMENT_PREVIEW",
              "INTERNAL_SUBSTRATE"
            ]
          },
          "customer_facing": {
            "type": "boolean"
          },
          "source_repository": {
            "type": "string",
            "minLength": 1
          },
          "source_product": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "delivery_modes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "customer_outcome": {
            "type": "string",
            "minLength": 1
          },
          "authority_boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
